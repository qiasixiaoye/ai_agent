# 复制为 .env 并填入真实值（.env 不要提交到 git）。
# 未填的留空即可，compose 里都有安全默认值。

# LLM（当前后端用 deepseek，OpenAI 兼容协议）
APP_LLM_PROVIDER=deepseek
SPRING_AI_OPENAI_BASE_URL=https://api.deepseek.com
SPRING_AI_OPENAI_CHAT_OPTIONS_MODEL=deepseek-chat
OPENAI_API_KEY=

# DashScope（百炼，可选）
SPRING_AI_DASHSCOPE_CHAT_OPTIONS_MODEL=qwen-plus
DASHSCOPE_API_KEY=dummy

# 工具外部 API（可选）
SEARCH_API_API_KEY=
IMAGE_API_API_KEY=

# Dify 集成（可选）
APP_DIFY_BASE_URL=
APP_DIFY_API_KEY=
APP_DIFY_DEFAULT_WORKFLOW_ID=
